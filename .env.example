# Copy to .env. Never commit the real file.

# LLM used to generate tuning advice
LLM_API_KEY=
LLM_API_BASE_URL=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Metrics store (this project's own database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dba_monitoring
POSTGRES_PORT=5433
POSTGRES_TABLES=metrics_history,query_performance,system_health

# Database under observation. Use a read-only role with pg_monitor.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Slack (optional; leave blank to disable)
SLACK_WEBHOOK_URL=
SLACK_TOKEN=
SLACK_CHANNEL=

# Expose the agent's own Prometheus metrics on 8002. Compose sets this to true;
# prometheus.yml scrapes it either way.
ENABLE_PROMETHEUS_SERVER=true

# Alert thresholds
MAX_CONNECTIONS_THRESHOLD=80
SLOW_QUERY_THRESHOLD_MS=1000
CACHE_HIT_RATIO_MIN=95
DEAD_TUPLES_THRESHOLD=10000
